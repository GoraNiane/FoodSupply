# =============================================================================
# FOODSUPPLY DAKAR — VARIABLES D'ENVIRONNEMENT (MODÈLE)
# Ne jamais commiter le fichier .env réel contenant vos secrets !
# =============================================================================

# Base de données TiDB Cloud (MySQL Serverless, TLS strict obligatoire)
# En local Windows : ajouter &sslcert=./isrgrootx1.pem (fichier dans prisma/isrgrootx1.pem)
DATABASE_URL="mysql://USER:PASSWORD@gateway01.eu-central-1.prod.aws.tidbcloud.com:4000/foodsupply?sslaccept=strict"

# Auth.js v5 / NextAuth (générer avec : openssl rand -base64 32)
NEXTAUTH_SECRET="CHANGE_ME_32_BYTES_RANDOM_BASE64"
NEXTAUTH_URL="https://votre-domaine.sn"
AUTH_TRUST_HOST="true"

# URL publique du site (utilisée pour SEO sitemap/robots, liens WhatsApp et emails)
NEXT_PUBLIC_APP_URL="https://votre-domaine.sn"

# Stockage d'images en production (Vercel Blob — optionnel : fallback persistant TiDB StoredMedia si absent)
BLOB_READ_WRITE_TOKEN=""
LOCAL_STORAGE_DIR="./storage"

# E-mails transactionnels (Resend — gratuit jusqu'à 3 000 emails/mois)
RESEND_API_KEY=""
EMAIL_FROM="FoodSupply Dakar <contact@foodsupply.sn>"

# Webhook paiement (HMAC-SHA256 — prêt pour future API Wave Business)
PAYMENT_WEBHOOK_SECRET="CHANGE_ME_WEBHOOK_SECRET"

# Optionnel : Meta WhatsApp Business Cloud API (sinon liens 1-clic wa.me utilisés automatiquement)
WHATSAPP_CLOUD_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
